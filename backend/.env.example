# Copy this file to .env in the same folder (backend/) and edit values.
# Required for the app to start (see app/core/config.py).

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/Plenvo
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Public frontend origin used in email links + Stripe success/cancel URLs
FRONTEND_URL=http://localhost:5173

# Resend transactional email (from hi@plenvo.io — domain verified in Resend)
# Also set this in the Render dashboard → Environment → RESEND_API_KEY
RESEND_API_KEY=
MAIL_FROM_EMAIL=hi@plenvo.io
MAIL_FROM_NAME=Plenvo

# Stripe billing (Checkout + webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional override for product images on Checkout
# STRIPE_PRODUCT_IMAGE_URL=https://plenvo.io/plenvo-icon-512.png

# Stripe Price IDs — one per currency × plan (Dashboard → Products → Prices)
STRIPE_PRICE_GBP_PERSONAL=
STRIPE_PRICE_GBP_TEAM=
STRIPE_PRICE_GBP_ENTERPRISE=
STRIPE_PRICE_EUR_PERSONAL=
STRIPE_PRICE_EUR_TEAM=
STRIPE_PRICE_EUR_ENTERPRISE=
STRIPE_PRICE_USD_PERSONAL=
STRIPE_PRICE_USD_TEAM=
STRIPE_PRICE_USD_ENTERPRISE=
STRIPE_PRICE_INR_PERSONAL=
STRIPE_PRICE_INR_TEAM=
STRIPE_PRICE_INR_ENTERPRISE=
